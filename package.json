{
  "name": "atlas-sentinel",
  "private": true,
  "version": "0.1.0",
  "description": "Industrial Safety Intelligence Operating System monorepo.",
  "workspaces": [
    "apps/frontend",
    "packages/shared-types",
    "packages/ui-components"
  ],
  "scripts": {
    "dev": "npm --workspace apps/frontend run dev",
    "build": "npm --workspace apps/frontend run build",
    "start": "npm --workspace apps/frontend run start",
    "frontend": "npm --workspace apps/frontend run dev",
    "sim:generate": "python apps/simulator/generate_dataset.py",
    "sim:evaluate": "python apps/simulator/evaluate_risk.py",
    "test:backend": "python apps/backend/run_tests.py",
    "rag:evaluate": "python apps/backend/run_rag_eval.py"
  }
}
